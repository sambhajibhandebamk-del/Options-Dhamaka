[app]
title = Index Options Bot
package.name = indexoptionsbot
package.domain = org.indexbot
source.dir = .
source.include_exts = py
source.exclude_dirs = tests, .github
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.archs = arm64-v8a
android.api = 33
android.minapi = 24
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
